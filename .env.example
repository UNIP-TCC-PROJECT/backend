# Banco de dados — NÃO existem valores padrão. Gere senhas fortes e DIFERENTES entre si (ex.: openssl rand -base64 36).
# Três papéis: admin (só administração do Postgres), migrator (dono do schema, roda migrations) e app (runtime, sem DDL).
# Local sem Docker: DB_HOST=localhost. No Docker, DB_HOST/DB_PORT são definidos pelo docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tcc_db
POSTGRES_ADMIN_USER=tcc_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_admin_min_16_chars
DB_MIGRATOR_USER=tcc_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_migrator_min_16_chars
DB_USER=tcc_app
DB_PASSWORD=CHANGE_ME_app_min_16_chars

# Autenticação JWT
JWT_SECRET=CHANGE_ME_gere_com_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Segurança (opcional em desenvolvimento)
# Chave para cifrar segredos MFA em repouso; se ausente, deriva do JWT_SECRET
MFA_ENCRYPTION_KEY=
# Origens permitidas no CORS, separadas por vírgula (ex.: https://app.exemplo.org)
CORS_ORIGINS=

# Validação institucional (consultas externas)
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Sem ela a consulta de sanções fica INDISPONIVEL e a aprovação exige justificativa do analista.
PORTAL_TRANSPARENCIA_API_KEY=
# Opcional — sobrescreve as URLs padrão (já corretas). Úteis para apontar a um espelho/stub em testes.
# BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1
# OPENCNPJ_URL=https://api.opencnpj.org
# MAPA_OSC_URL=https://mapaosc.ipea.gov.br/api/api/busca/cnpj
# TRANSFEREGOV_URL=https://api-publica.transferegov.gestao.gov.br/parcerias
# PORTAL_TRANSPARENCIA_URL=https://api.portaldatransparencia.gov.br/api-de-dados

# Pagamentos Pix (Asaas) — sandbox por padrão
# Chave do sandbox: https://sandbox.asaas.com (Integrações → Chave de API)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token do webhook (32–255 caracteres, sem espaços). Cadastre o MESMO valor como authToken do webhook no Asaas,
# apontando para https://SEU-DOMINIO/webhooks/asaas (em dev use um túnel, ex.: ngrok).
ASAAS_WEBHOOK_TOKEN=

# Subcontas por ONG (Asaas): a chave de API de cada subconta é guardada CIFRADA no banco com esta chave mestra.
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Perder/trocar esta chave torna as credenciais já guardadas ilegíveis (a chave da subconta não pode ser recuperada no Asaas).
PAYMENT_ENCRYPTION_KEY=
# (Opcional) URL pública do webhook, enviada na criação de cada subconta junto com ASAAS_WEBHOOK_TOKEN.
# Ex.: https://SEU-DOMINIO/webhooks/asaas   (em dev, o endereço do ngrok)
# ASAAS_WEBHOOK_URL=
