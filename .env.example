# Banco de dados
# Usado ao rodar localmente (yarn start:dev); no Docker os valores vêm do docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tcc_db

# Autenticação JWT
JWT_SECRET=uma_chave_super_secreta_e_longa_aqui
JWT_EXPIRES_IN=7d

# Segurança (opcional em desenvolvimento)
# Chave para cifrar segredos MFA em repouso; se ausente, deriva do JWT_SECRET
MFA_ENCRYPTION_KEY=
# Origens permitidas no CORS, separadas por vírgula (ex.: https://app.exemplo.org)
CORS_ORIGINS=

# Validação institucional (consultas externas)
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Sem ela a consulta de sanções fica INDISPONIVEL e a aprovação exige justificativa do analista.
PORTAL_TRANSPARENCIA_API_KEY=
